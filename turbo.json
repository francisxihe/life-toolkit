{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "start": {
      "cache": false,
      "persistent": true,
      "inputs": ["apps/**/*.ts", "packages/**/*.ts"]
    },
    "debug": {
      "cache": false,
      "persistent": true,
      "inputs": ["apps/**/*.ts", "packages/**/*.ts"]
    },
    "pre-commit": {
      "cache": false,
      "persistent": true,
      "inputs": ["apps/**/*.ts", "packages/**/*.ts"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "test": {
      "cache": false,
      "outputs": ["coverage/**"],
      "inputs": ["test/**/*.ts", "test/**/*.tsx"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": ["apps/desktop/**/*.{ts,tsx}", "packages/**/*.{ts,tsx}"]
    },
    "dev:product": {
      "cache": false,
      "persistent": true,
      "inputs": ["apps/desktop/**/*.{ts,tsx}", "packages/**/*.{ts,tsx}"]
    },
    "dev:electron": {
      "cache": false,
      "persistent": true,
      "inputs": ["apps/desktop/**/*.ts"]
    },
    "deploy": {
      "cache": false,
      "persistent": true,
      "inputs": ["apps/desktop/**/*.ts"]
    }
  }
}
