    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "chokidar": "^4.0.3",
    "electron": "36.0.0",
    "electron-builder": "^26.0.12",
    "electron-devtools-installer": "^3.2.1",
    "electron-is-dev": "^2.0.0",
