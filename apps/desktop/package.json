    "francis-mapped-types": "0.0.1",
    "insert-css": "^2.0.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.460.0",
    "mockjs": "^1.1.0",
    "nanostores": "^0.11.3",
    "nprogress": "^0.2.0",
    "query-string": "^6.13.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^7.2.6",
    "react-router": "^5.2.0",
    "react-router-dom": "^6.25.1",
