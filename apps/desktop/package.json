        "get-intrinsic": "^1.2.4",
        "has-property-descriptors": "^1.0.2",
        "gopd": "^1.0.1",
        "define-data-property": "^1.1.4",
        "concat-map": "^0.0.1",
        "brace-expansion": "^1.1.11",
        "minimatch": "^3.1.2",
        "balanced-match": "^1.0.2",
        "glob": "^7.2.3",
        "fs.realpath": "^1.0.0",
        "inflight": "^1.0.6",
        "once": "^1.4.0",
        "wrappy": "^1.0.2",
        "path-is-absolute": "^1.0.1",
        "path-scurry": "^1.10.1"
      }
