  "build": {
    "appId": "com.lifetoolkit.app",
    "productName": "知止",
    "electronVersion": "36.0.0",
    "files": [
      "dist/**/*"
    ],
    "extraMetadata": {
      "dependencies": {
        "tslib": "^2.6.2",
        "inherits": "^2.0.4",
        "safe-buffer": "^5.2.1",
