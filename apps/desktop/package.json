    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "asar": false,
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir"
    },
    "win": {
      "target": "dir"
    },
    "linux": {
      "target": "dir"
    }
