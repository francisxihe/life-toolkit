{
  "id": "growth.todo",
  "kind": "module",
  "title": "待办管理",
  "document": "growth/todo/README.md",
  "parentId": "growth",
  "route": "/growth/todo",
  "positioning": "承接手动事项和系统生成行动的最小执行颗粒，帮助用户安排今天要做的事。",
  "dependencies": [
    "growth.goal",
    "growth.task",
    "growth.habit",
    "growth.repeat"
  ],
  "entities": [
    {
      "id": "todo",
      "name": "待办",
      "fields": [
        {
          "id": "relatedType",
          "name": "创建来源",
          "type": "enum",
          "required": true,
          "values": [
            "task",
            "goal",
            "habit",
            "none"
          ],
          "description": "手动创建的待办固定为独立事项；仅系统生成待办可关联目标、任务或习惯，且只能有一个来源。",
          "productStatus": "roadmap",
          "prototypeCoverage": "complete"
        },
        {
          "id": "importance",
          "name": "重要性",
          "type": "number",
          "required": true,
          "description": "1 至 5，参与优先级矩阵。",
          "productStatus": "roadmap",
          "prototypeCoverage": "complete"
        },
        {
          "id": "plannedStartTime",
          "name": "计划开始时间",
          "type": "time",
          "required": true,
          "description": "待办在计划日期内的开始时间，格式为 HH:mm；与计划结束时间相等时表示一个时间点。",
          "productStatus": "roadmap",
          "prototypeCoverage": "complete"
        },
        {
          "id": "plannedEndTime",
          "name": "计划结束时间",
          "type": "time",
          "required": true,
          "description": "待办在计划日期内的结束时间，格式为 HH:mm；等于开始时间表示时间点，作为时间范围时必须晚于开始时间。",
          "productStatus": "roadmap",
          "prototypeCoverage": "complete"
        },
        {
          "id": "urgency",
          "name": "紧急性",
          "type": "number",
          "required": true,
          "description": "1 至 5，参与优先级矩阵。",
          "productStatus": "roadmap",
          "prototypeCoverage": "complete"
        },
        {
          "id": "status",
          "name": "状态",
          "type": "enum",
          "required": true,
          "values": [
            "todo",
            "done",
            "abandoned"
          ],
          "description": "待办执行状态；不含进行中，执行投入通过专注计时关联记录。",
          "productStatus": "roadmap",
          "prototypeCoverage": "complete"
        },
        {
          "id": "repeat",
          "name": "重复规则",
          "type": "object",
          "required": false,
          "description": "独立待办可选用统一重复规则；启用后作为单模板推进当前实例并记录已结算次数。",
          "productStatus": "roadmap",
          "prototypeCoverage": "complete"
        }
      ],
      "productStatus": "roadmap",
      "prototypeCoverage": "complete"
    }
  ],
  "views": [
    {
      "id": "today",
      "name": "当前待办",
      "prototypePage": "todo",
      "scenario": "聚焦选定日期的行动",
      "reference": "growth.todo.view.today",
      "productStatus": "roadmap",
      "prototypeCoverage": "partial"
    },
    {
      "id": "week",
      "name": "本周待办",
      "prototypePage": "todo",
      "scenario": "安排周度执行",
      "reference": "growth.todo.view.week",
      "productStatus": "deprecated",
      "prototypeCoverage": "none"
    },
    {
      "id": "calendar",
      "name": "待办日历",
      "prototypePage": "todo",
      "scenario": "查看长期排程",
      "reference": "growth.todo.view.calendar",
      "productStatus": "roadmap",
      "prototypeCoverage": "partial"
    },
    {
      "id": "all",
      "name": "全部待办",
      "prototypePage": "todo",
      "scenario": "筛选与批量治理；含进行中重复当前实例，并提供删除",
      "reference": "growth.todo.view.all",
      "productStatus": "roadmap",
      "prototypeCoverage": "complete"
    },
    {
      "id": "statistics",
      "name": "待办统计",
      "prototypePage": "todo",
      "scenario": "复盘效率和优先级分布",
      "reference": "growth.todo.view.statistics",
      "productStatus": "deprecated",
      "prototypeCoverage": "none"
    }
  ],
  "rules": [
    {
      "id": "related-inheritance",
      "name": "关联约束继承",
      "entities": [
        "todo"
      ],
      "description": "系统生成待办可关联目标、任务或习惯，来源不可通过手动编辑改写；关联目标或任务时需遵守其时间和重要度约束。",
      "views": [
        "today",
        "all"
      ],
      "reference": "growth.todo.rule.related-inheritance",
      "productStatus": "roadmap",
      "prototypeCoverage": "partial"
    },
    {
      "id": "batch-limit",
      "name": "批量操作上限",
      "entities": [
        "todo"
      ],
      "description": "批量操作单次最多处理 50 条待办。",
      "views": [
        "all"
      ],
      "reference": "growth.todo.rule.batch-limit",
      "productStatus": "roadmap",
      "prototypeCoverage": "partial"
    },
    {
      "id": "repeat-template",
      "name": "周期待办模板推进",
      "entities": [
        "todo"
      ],
      "description": "独立周期待办只维护当前实例，并在当前、日历与全部中展示；结算后留下历史实例并推进下一次，达到结束条件则保留已结算历史。",
      "views": [
        "today",
        "calendar",
        "all"
      ],
      "reference": "growth.todo.rule.repeat-template",
      "productStatus": "roadmap",
      "prototypeCoverage": "complete"
    },
    {
      "id": "focus-range-only",
      "name": "区间计划可关联专注",
      "entities": [
        "todo"
      ],
      "description": "未完成且计划起止时间为区间的待办，可从待办入口唤起全局专注计时并关联该待办；计划为时间点时不可从待办入口管理计时，已有关联记录仍可只读查看。专注结束不改变待办状态。",
      "views": [
        "today",
        "all"
      ],
      "reference": "growth.todo.rule.focus-range-only",
      "productStatus": "roadmap",
      "prototypeCoverage": "complete"
    },
    {
      "id": "edit-no-repeat-toggle",
      "name": "编辑不可切换是否重复",
      "entities": [
        "todo"
      ],
      "description": "仅新建独立待办时可开启或关闭重复；编辑时不可切换是否重复，已启用重复时仍可调整规则细节。",
      "views": [
        "today",
        "all"
      ],
      "reference": "growth.todo.rule.edit-no-repeat-toggle",
      "productStatus": "roadmap",
      "prototypeCoverage": "complete"
    },
    {
      "id": "delete-boundary",
      "name": "删除入口与重复删除",
      "entities": [
        "todo"
      ],
      "description": "当前待办与待办日历不提供删除；全部待办提供删除。进行中的独立重复待办只能在全部待办删除系列定义；删除后停止后续生成，已完成或已放弃的历史实例保留。",
      "views": [
        "today",
        "calendar",
        "all"
      ],
      "reference": "growth.todo.rule.delete-boundary",
      "productStatus": "roadmap",
      "prototypeCoverage": "complete"
    }
  ],
