{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "true-north-product-wiki",
  "title": "ProductWiki module specification",
  "type": "object",
  "required": ["id", "kind", "title", "productStatus", "surfaceCoverage", "references"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "kind": { "enum": ["global", "domain", "module"] },
    "title": { "type": "string", "minLength": 1 },
    "parentId": { "type": "string" },
    "route": { "type": "string" },
    "positioning": { "type": "string" },
    "productStatus": { "$ref": "#/$defs/productStatus" },
    "surfaceCoverage": { "$ref": "#/$defs/surfaceCoverage" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "entities": { "$ref": "#/$defs/entities" },
    "views": { "$ref": "#/$defs/views" },
    "rules": { "$ref": "#/$defs/rules" },
    "references": { "$ref": "#/$defs/references" }
  },
  "additionalProperties": false,
  "$defs": {
    "productStatus": { "enum": ["roadmap", "released", "deprecated"] },
    "surfaceCoverage": { "enum": ["none", "partial", "complete"] },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "productStatus", "surfaceCoverage", "fields"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "productStatus": { "$ref": "#/$defs/productStatus" },
          "surfaceCoverage": { "$ref": "#/$defs/surfaceCoverage" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "type", "required", "description", "productStatus", "surfaceCoverage"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "type": { "type": "string" },
                "required": { "type": "boolean" },
                "values": { "type": "array", "items": { "type": "string" } },
                "description": { "type": "string" },
                "productStatus": { "$ref": "#/$defs/productStatus" },
                "surfaceCoverage": { "$ref": "#/$defs/surfaceCoverage" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "desktopRoute", "scenario", "productStatus", "surfaceCoverage", "reference"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "desktopRoute": { "type": "string" },
          "scenario": { "type": "string" },
          "productStatus": { "$ref": "#/$defs/productStatus" },
          "surfaceCoverage": { "$ref": "#/$defs/surfaceCoverage" },
          "reference": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "entities", "description", "reference", "productStatus", "surfaceCoverage"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "entities": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" },
          "views": { "type": "array", "items": { "type": "string" } },
          "reference": { "type": "string" },
          "productStatus": { "$ref": "#/$defs/productStatus" },
          "surfaceCoverage": { "$ref": "#/$defs/surfaceCoverage" }
        },
        "additionalProperties": false
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "body"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
