{
  "name": "@true-north/dev-tools",
  "private": true,
  "version": "0.1.0",
  "description": "True North 开发辅助工具",
  "main": "src/watch-controllers.ts",
  "scripts": {
    "watch:dto": "tsx ./src/watch-dto/index.ts",
    "sync:dto": "tsx ./src/watch-dto/index.ts --once && cd ../../ && npx prettier --write **/*.{js,jsx,ts,tsx,json,css,scss,less,html,md} --ignore-path .gitignore",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "tsx ./src/server/index.ts",
    "start": "concurrently \"pnpm build\" \"pnpm server\"",
    "dev:full": "concurrently \"pnpm dev\" \"pnpm server\""
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@sue/design-web-react": "0.0.3-beta.1",
    "@types/express": "^4.17.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "chokidar": "^3.6.0",
    "commander": "^11.0.0",
    "concurrently": "^8.2.0",
    "express": "^4.18.0",
    "fast-glob": "^3.3.2",
    "lodash-es": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-morph": "^26.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
